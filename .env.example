# Docker Compose project scope. Changing this creates an independent stack.
COMPOSE_PROJECT_NAME=wp-site-options

# Local URL. `make setup` adds an idempotent hosts-file mapping when needed.
WP_HOST=wp-site-options.local
WP_BIND_ADDRESS=127.0.0.1
WP_HTTP_PORT=8088
WP_DEBUG=1
WP_TITLE="WP Site Options Local"
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=admin@wp-site-options.local

# Multi-architecture images work on WSL2, native Linux, and Apple Silicon/Intel macOS.
NGINX_IMAGE=nginx:1.31.5-alpine
PHP_BASE_IMAGE=wodby/wordpress-php:8.4-4.80.9
MYSQL_IMAGE=mysql:8.0.46
PHP_EXTENSIONS_DISABLE=xdebug,xhprof,spx

# Bound Docker json-file logs. PHP application logs use the php-logs volume.
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=3

# Local-development credentials only. Keep real values in the ignored .env file.
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress-local
DB_ROOT_PASSWORD=wordpress-root-local
