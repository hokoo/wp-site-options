# Docker Compose project scope. Changing this creates an independent stack.
COMPOSE_PROJECT_NAME=wp-site-options

# Local URL: add `127.0.0.1 wp-site-options.local` to the host hosts file.
WP_HOST=wp-site-options.local
WP_BIND_ADDRESS=127.0.0.1
WP_HTTP_PORT=8088
WP_DEBUG=1

# Override these tags to test another supported WordPress/PHP or database profile.
WORDPRESS_IMAGE=wordpress:php8.3-apache
WP_CLI_IMAGE=wordpress:cli-php8.3
DB_IMAGE=mariadb:10.11

# Local-development credentials only. Keep real values in the ignored .env file.
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress-local
DB_ROOT_PASSWORD=wordpress-root-local
